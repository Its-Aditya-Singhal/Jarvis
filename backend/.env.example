# All optional. Defaults shown.
# JARVIS_CAMERA_INDEX=0
# JARVIS_PROCESS_FPS=6
# JARVIS_FACE_THRESHOLD=0.42         # cosine similarity needed to accept a frame
# JARVIS_FACE_REJECT_THRESHOLD=0.25  # below this a face counts as a stranger
# JARVIS_REAUTH_INTERVAL_S=30        # approval expires without a fresh match
# JARVIS_ABSENCE_LOCK_S=8            # owner away this long -> session locked
# JARVIS_DATA_DIR=~/Library/Application Support/JarvisAssistant
# JARVIS_MIC_DEVICE=                 # input device name; default system input
# JARVIS_VOICE_THRESHOLD=0.50        # voice similarity needed to verify
# JARVIS_VOICE_REJECT_THRESHOLD=0.30 # below this the voice counts as unknown
# JARVIS_VOICE_VALID_S=20            # a voice match counts for this long
